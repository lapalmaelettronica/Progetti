from flask import Flask\
import os\
\
app = Flask(__name__)\
\
@app.route('/shutdown', methods=['GET'])\
def shutdown_robot():\
    print("Comando di spegnimento ricevuto dal telecomando!")\
    # Aspetta 1 secondo e poi lancia il comando di poweroff\
    os.system("sleep 1 && sudo poweroff &")\
    return "Spegnimento in corso...", 200\
\
if __name__ == '__main__':\
    # In ascolto su tutte le interfacce Wi-Fi sulla porta 5000\
    app.run(host='0.0.0.0', port=5000)\
