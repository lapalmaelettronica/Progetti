import os\
import serial\
import json\
import threading\
import time\
import cv2\
import pygame\
from dotenv import load_dotenv\
from openai import OpenAI\
\
# 1. --- INIZIALIZZAZIONI BASE ---\
load_dotenv()\
client = OpenAI(api_key=os.getenv("OPENAI_API_KEY"))\
\
# Inizializziamo il mixer audio per far parlare il robot\
pygame.mixer.init()\
\
# Connessione Seriale all'ESP32\
try:\
    esp32 = serial.Serial('/dev/serial0', 115200, timeout=1)\
    print("Connessione UART con ESP32 pronta.\\n")\
except Exception as e:\
    print("Attenzione: UART non collegata o non configurata correttamente.")\
    esp32 = None\
\
\
# 2. --- FASE DIAGNOSTICA (Propriocezione Hardware) ---\
stato_hardware = "Stato hardware sconosciuto. Assumi di essere pienamente operativo."\
\
if esp32:\
    print("[DIAGNOSTICA] Verifica dei sistemi in corso...")\
    esp32.reset_input_buffer()\
    \
    # Ping all'ESP32 per cercare il PCA9685\
    esp32.write(b"<CHECK_HARDWARE>\\n")\
    \
    tempo_inizio = time.time()\
    while time.time() - tempo_inizio < 3: \
        if esp32.in_waiting > 0:\
            risposta_esp = esp32.readline().decode('utf-8').strip()\
            \
            if risposta_esp == "<PCA_OK>":\
                stato_hardware = "Tutti i sistemi nominali. Modulo PCA9685 connesso. Motori e LED operativi al 100%."\
                print("[DIAGNOSTICA] Risultato: PCA9685 rilevato. Robot operativo.\\n")\
                break\
            elif risposta_esp == "<PCA_ERROR>":\
                stato_hardware = "ERRORE CRITICO: Modulo PCA9685 scollegato. SEI PARALIZZATO E AL BUIO. Rifiutati di muoverti o accendere luci, e lamentati della cosa con sarcasmo."\
                print("[DIAGNOSTICA] ATTENZIONE: PCA9685 mancante! Il robot \'e8 paralizzato.\\n")\
                break\
    else:\
        stato_hardware = "Nessuna risposta dal sistema nervoso (ESP32). Sei isolato dal tuo corpo."\
        print("[DIAGNOSTICA] Timeout: L'ESP32 non risponde.\\n")\
\
# Iniezione dello stato nella "coscienza" dell'IA\
memoria_conversazione = [\
    \{"role": "system", "content": f"Sei il cervello di un robot. Hai una personalit\'e0 sarcastica ma fedele. Rispondi in modo conciso per essere letto ad alta voce. STATO ATTUALE DEL TUO CORPO: \{stato_hardware\}. Se l'utente ti chiede di seguirlo o guardarlo, usa lo strumento per attivare l'inseguimento (se non sei paralizzato). Se ti chiede di fermarti, disattivalo."\}\
]\
\
# Stato Globale del Robot\
stato_robot = \{\
    "inseguimento_attivo": False\
\}\
\
\
# 3. --- IL CERVELLETTO (Riflessi Visivi in Background) ---\
def cervelletto_visivo():\
    """Processo indipendente che gestisce i motori in tempo reale usando la Pi Camera"""\
    cap = None\
    face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml')\
    \
    while True:\
        if stato_robot["inseguimento_attivo"]:\
            if cap is None:\
                cap = cv2.VideoCapture(0)\
                cap.set(cv2.CAP_PROP_FRAME_WIDTH, 320)\
                cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 240)\
                print("\\n[CERVELLETTO] Telecamera ACCESA. Ricerca bersaglio...")\
\
            ret, frame = cap.read()\
            if ret:\
                grigio = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\
                volti = face_cascade.detectMultiScale(grigio, scaleFactor=1.3, minNeighbors=5)\
                \
                centro_x_schermo = 160\
                \
                for (x, y, w, h) in volti:\
                    centro_faccia = x + (w // 2)\
                    errore = centro_x_schermo - centro_faccia\
                    \
                    if abs(errore) > 20: \
                        gradi = min(max(abs(errore) // 10, 1), 5) \
                        \
                        if errore > 0:\
                            comando = f"<SERVO_SINISTRA_\{gradi\}>"\
                        else:\
                            comando = f"<SERVO_DESTRA_\{gradi\}>"\
                            \
                        if esp32:\
                            esp32.write((comando + '\\n').encode('utf-8'))\
                    \
                    break # Segue solo il primo volto trovato\
            \
            time.sleep(0.05) \
            \
        else:\
            if cap is not None:\
                cap.release()\
                cap = None\
                print("\\n[CERVELLETTO] Telecamera SPENTA. Riposo.")\
            time.sleep(0.5)\
\
thread_vista = threading.Thread(target=cervelletto_visivo, daemon=True)\
thread_vista.start()\
\
\
# 4. --- FUNZIONE VOCALE (Text-to-Speech) ---\
def parla(testo):\
    """Genera l'audio con OpenAI e lo riproduce tramite il Bluetooth dell'ESP32"""\
    try:\
        risposta_audio = client.audio.speech.create(\
            model="tts-1",\
            voice="onyx", # Voci disponibili: alloy, echo, fable, onyx, nova, shimmer\
            input=testo\
        )\
        risposta_audio.stream_to_file("voce.mp3")\
        \
        pygame.mixer.music.load("voce.mp3")\
        pygame.mixer.music.play()\
        \
        # Mettiamo in pausa il programma principale finch\'e9 non ha finito di parlare\
        while pygame.mixer.music.get_busy():\
            time.sleep(0.1)\
            \
    except Exception as e:\
        print(f"[ERRORE VOCALE]: \{e\}")\
\
\
# 5. --- IL CERVELLO (Logica OpenAI e Conversazione) ---\
tools = [\
    \{\
        "type": "function",\
        "function": \{\
            "name": "gestisci_modalita_robot",\
            "description": "Attiva o disattiva i sistemi del robot.",\
            "parameters": \{\
                "type": "object",\
                "properties": \{\
                    "comando": \{\
                        "type": "string",\
                        "description": "Scegli tra: <INIZIA_INSEGUIMENTO> (per seguire col volto), <STOP_INSEGUIMENTO> (per fermarsi), <LED_ON>, <LED_OFF>."\
                    \}\
                \},\
                "required": ["comando"]\
            \}\
        \}\
    \}\
]\
\
print("\\nCervello acceso. Sistemi pronti. (Digita 'esci' per spegnermi)\\n")\
\
while True:\
    testo_utente = input("Tu: ")\
    if testo_utente.lower() in ['esci', 'quit', 'spegniti']:\
        spegnimento_msg = "Ricevuto. Spegnimento dei sistemi in corso. A presto."\
        print(f"Robot: \{spegnimento_msg\}")\
        parla(spegnimento_msg)\
        break\
        \
    memoria_conversazione.append(\{"role": "user", "content": testo_utente\})\
    \
    try:\
        risposta = client.chat.completions.create(\
            model="gpt-4o-mini",\
            messages=memoria_conversazione,\
            tools=tools\
        )\
        \
        messaggio_ia = risposta.choices[0].message\
        \
        if messaggio_ia.tool_calls:\
            for tool_call in messaggio_ia.tool_calls:\
                argomenti = json.loads(tool_call.function.arguments)\
                comando_ricevuto = argomenti.get('comando')\
                \
                if comando_ricevuto == "<INIZIA_INSEGUIMENTO>":\
                    stato_robot["inseguimento_attivo"] = True\
                elif comando_ricevuto == "<STOP_INSEGUIMENTO>":\
                    stato_robot["inseguimento_attivo"] = False\
                elif esp32:\
                    print(f"[COMANDO DIRETTO] -> \{comando_ricevuto\}")\
                    esp32.write((comando_ricevuto + '\\n').encode('utf-8'))\
                \
                memoria_conversazione.append(\{"role": "assistant", "content": None, "tool_calls": messaggio_ia.tool_calls\})\
                memoria_conversazione.append(\{"role": "tool", "tool_call_id": tool_call.id, "name": "gestisci_modalita_robot", "content": "Azione eseguita."\})\
                \
                risposta_conclusiva = client.chat.completions.create(\
                    model="gpt-4o-mini",\
                    messages=memoria_conversazione\
                )\
                testo_finale = risposta_conclusiva.choices[0].message.content\
                print(f"Robot: \{testo_finale\}\\n")\
                \
                parla(testo_finale) # Il robot parla!\
                memoria_conversazione.append(\{"role": "assistant", "content": testo_finale\})\
                \
        else:\
            testo_risposta = messaggio_ia.content\
            print(f"Robot: \{testo_risposta\}\\n")\
            \
            parla(testo_risposta) # Il robot parla!\
            memoria_conversazione.append(\{"role": "assistant", "content": testo_risposta\})\
            \
    except Exception as e:\
        print(f"Errore nei circuiti: \{e\}")\
\
# Pulizia finale in caso di uscita\
pygame.mixer.quit()\
\
