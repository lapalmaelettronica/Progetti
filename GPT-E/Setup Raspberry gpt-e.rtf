# Carica la chiave e avvia il client\
load_dotenv()\
client = OpenAI(api_key=os.getenv("OPENAI_API_KEY"))\
\
# 1. Inizializziamo la memoria con la "Personalit\'e0" (System Prompt)\
# Ho aggiunto l'istruzione di essere sintetico, perfetto per un robot.\
memoria_conversazione = [\
    \{"role": "system", "content": "Sei il cervello di un robot. Hai una personalit\'e0 un po' sarcastica ma sei leale al tuo creatore. Le tue risposte devono essere sempre sintetiche, dirette e senza fronzoli."\}\
]\
\
print("Cervello acceso. Memoria inizializzata. (Digita 'esci' per spegnermi)\\n")\
\
# 2. Iniziamo il Loop infinito della conversazione\
while True:\
    # Aspetta che tu scriva qualcosa\
    testo_utente = input("Tu: ")\
    \
    # Condizione per uscire dal programma\
    if testo_utente.lower() in ['esci', 'quit', 'spegniti']:\
        print("Robot: Ricevuto. Spegnimento dei sistemi in corso. A presto.")\
        break\
        \
    # 3. Aggiungiamo la tua frase alla memoria della conversazione\
    memoria_conversazione.append(\{"role": "user", "content": testo_utente\})\
    \
    try:\
        # 4. Mandiamo TUTTA la memoria a OpenAI per avere il contesto\
        risposta = client.chat.completions.create(\
            model="gpt-4o-mini",\
            messages=memoria_conversazione\
        )\
        \
        testo_risposta = risposta.choices[0].message.content\
        \
        # 5. Stampiamo la risposta del robot\
        print(f"\\nRobot: \{testo_risposta\}\\n")\
        \
        # 6. Salviamo la risposta del robot nella memoria, cos\'ec se la ricorder\'e0 al prossimo turno!\
        memoria_conversazione.append(\{"role": "assistant", "content": testo_risposta\})\
        \
    except Exception as e:\
        print(f"Errore nei circuiti: \{e\}")\
